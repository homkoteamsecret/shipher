# Секрет для JWT — ОБЯЗАТЕЛЬНО смени в проде
CIPHER_SECRET=change-me-to-random-64-chars

# Порт
PORT=3000

# Домен(ы) для CORS, через запятую
# Пример: https://cipher.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Окружение: development | production
NODE_ENV=development

# Максимальный размер файла в МБ
MAX_FILE_MB=30

# Папка для загрузок (по умолчанию ./uploads)
UPLOAD_DIR=uploads
